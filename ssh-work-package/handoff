#!/bin/sh
set -eu
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
for runtime in /opt/homebrew/bin/python3 /usr/local/bin/python3 /usr/bin/python3; do
    if [ -x "$runtime" ]; then
        exec "$runtime" "$script_dir/ssh_handoff.py" "$@"
    fi
done
echo 'Python 3 is required. Install it with: brew install python' >&2
exit 1
