#!/bin/sh
set -eu

usage() {
    cat <<'EOF'
Usage: switch [here|send|status] [handoff options]

  switch here    Bring the keyboard and trackpad to this Mac.
  switch send    Send the keyboard and trackpad to the other Mac.
  switch status  Show connections on both Macs.
  switch         Toggle between Macs.

Options such as --device trackpad, --timeout 90, and --dry-run are supported.
EOF
}

case "${1-}" in
    help|-h|--help) usage; exit 0 ;;
esac

handoff="$HOME/Applications/swish/handoff"
if [ ! -x "$handoff" ]; then
    printf 'switch: Missing executable: %s\n' "$handoff" >&2
    exit 1
fi

case "${1-}" in
    here) shift; exec "$handoff" --to here "$@" ;;
    send) shift; exec "$handoff" --to other "$@" ;;
    status) shift; exec "$handoff" --status "$@" ;;
    '') exec "$handoff" ;;
    -*) exec "$handoff" "$@" ;;
    *) usage >&2; exit 2 ;;
esac
